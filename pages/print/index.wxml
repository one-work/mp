<view wx:if="{{registeredDevices.length > 0}}" class="box">
  <text>绑定设备为：</text>
  <view wx:for="{{registeredDevices}}" wx:key="index" class="box">
    <text>{{item}}</text>
  </view>
</view>

<printers
  id="printers"
  deviceName="{{registeredDevices.join(',')}}"
  bind:ready="printerReady"
  bind:connected="printerConnected"
  bind:selected="printerSelected"
  bind:unselected="printerUnselected"
></printers>

<view class="box text-centered">
  <text>{{ state }}</text>
</view>
